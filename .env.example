# ==============================================================================
# Google Cloud & Environment Settings
# ==============================================================================
# 고객사의 Google Cloud 프로젝트 ID
GCP_PROJECT_ID=your-gcp-project-id

# Vertex AI 리전 (기본값: global 또는 us-central1)
GCP_LOCATION=global

# 대용량 미디어 임시 업로드용 GCS 버킷명
TEMP_GCS_BUCKET=your-gcp-project-id-meet-audio-temp

# ==============================================================================
# Service Endpoints (배포 후 자동 생성되는 엔드포인트 URL)
# ==============================================================================
LOCAL_API_SERVER_URL=http://localhost:9090
CLOUD_RUN_SERVICE_URL=https://coway-meet-notes-service-xxxxx-uc.a.run.app
AGENT_GATEWAY_URL=https://coway-agent-gateway-xxxxx.uc.gateway.dev

# ==============================================================================
# Vertex AI Gemini 3.7 Model Settings
# ==============================================================================
GEMINI_MODEL_NAME=gemini-3.7-flash
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=4096
GOOGLE_API_USE_CLIENT_CERTIFICATE=false
GOOGLE_API_USE_MTLS_ENDPOINT=never

# ==============================================================================
# Google Workspace OAuth (선택 사항: Google Calendar/Meet/Drive 연동 시)
# ==============================================================================
CREDENTIALS_FILE_PATH=credentials.json
TOKEN_FILE_PATH=token.json
